{
  "applicationId": "com.mercury.ui",
  "applicationName": "Mercury UI",
  "applicationIcon": "ui/public/mercury-logo.png",
  "description": "Mercury UI - Halo CE Package Manager",
  "copyright": "2026 Insurrection Team",
  "version": "1.0.0",
  "defaultMode": "window",
  "documentRoot": "/ui/dist/",
  "url": "/",
  "port": 3000,
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "nativeAllowList": [
    "app.*",
    "os.execCommand",
    "os.spawnProcess",
    "os.updateSpawnedProcess",
    "os.getEnv",
    "os.showFolderDialog",
    "os.showOpenDialog",
    "os.getPath"
  ],
  "modes": {
    "window": {
      "title": "Mercury UI",
      "width": 900,
      "height": 510,
      "minWidth": 800,
      "minHeight": 510,
      "icon": "/ui/public/mercury-logo.png",
      "useSavedState": true
    }
  },
  "cli": {
    "binaryName": "mercury-ui",
    "resourcesPath": "/ui/dist/",
    "extensionsPath": "/extensions/",
    "frontendLibrary": {
      "patchFile": "/ui/index.html",
      "devUrl": "http://localhost:5173",
      "projectPath": "/ui/",
			"initCommand": "bun install",
			"devCommand": "bun run dev",
			"buildCommand": "bun run build"
    },
    "binaryVersion": "6.7.0"
  },
  "logging": {
    "enabled": true,
    "writeToLogFile": true
  }
}